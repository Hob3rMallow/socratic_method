{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/socratic-method/recipe.schema.json",
  "title": "Socratic Method training recipe",
  "type": "object",
  "required": [
    "schema",
    "name",
    "version",
    "artifacts",
    "model",
    "release",
    "objective",
    "optimization",
    "evaluation",
    "training"
  ],
  "properties": {
    "schema": {
      "const": "socratic-method-training-recipe-v1"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "artifacts": {
      "type": "object"
    },
    "model": {
      "type": "object"
    },
    "release": {
      "type": "object",
      "required": [
        "status",
        "selected_checkpoint",
        "operating_threshold",
        "threshold_selection_contract",
        "inference",
        "selection",
        "qualification"
      ],
      "properties": {
        "status": {
          "const": "selected"
        },
        "selected_checkpoint": {
          "type": "object",
          "required": [
            "samples",
            "sha256",
            "bytes"
          ],
          "properties": {
            "samples": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "operating_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "threshold_selection_contract": {
          "type": "string",
          "minLength": 1
        },
        "inference": {
          "const": "raw-student-only-no-m7-blend-no-teacher"
        },
        "selection": {
          "type": "string",
          "minLength": 1
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        },
        "known_limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "previous_release_id": {
          "type": "string",
          "minLength": 1
        },
        "training_record_operating_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "test_time_augmentation": {
          "enum": [
            "none",
            "8-way-mirror"
          ]
        },
        "inference_record": {
          "type": "string",
          "minLength": 1
        },
        "inference_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "objective": {
      "type": "object"
    },
    "optimization": {
      "type": "object"
    },
    "evaluation": {
      "type": "object"
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "inference": {
      "type": "object",
      "description": "Pinned runner parameters for socratic-predict. Absent from historical recipes, which socratic-predict refuses.",
      "required": [
        "operating_threshold",
        "postprocessor_threshold",
        "test_time_augmentation",
        "mirror_tta",
        "amp_dtype",
        "chunk_size",
        "halo_voxels",
        "context_shape_zyx",
        "device",
        "max_cpu_threads"
      ],
      "properties": {
        "operating_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "postprocessor_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "test_time_augmentation": {
          "enum": [
            "none",
            "8-way-mirror"
          ]
        },
        "mirror_tta": {
          "type": "boolean"
        },
        "amp_dtype": {
          "enum": [
            "bfloat16",
            "float16"
          ]
        },
        "chunk_size": {
          "type": "integer",
          "minimum": 1
        },
        "halo_voxels": {
          "type": "integer",
          "minimum": 0
        },
        "context_shape_zyx": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "max_cpu_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "raw_contract": {
          "type": "object"
        },
        "voxel_size_um": {
          "type": "object"
        },
        "deliverable": {
          "type": "object"
        }
      }
    },
    "training": {
      "type": "object",
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
